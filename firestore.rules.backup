rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'evansshelby465@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email_verified == true)
      );
    }

    // Orders Collection
    match /orders/{orderId} {
      // Clients track orders in real-time, manager listens to all incoming orders
      allow read: if isValidId(orderId);

      // Client order creation with strict validation
      allow create: if isValidId(orderId)
        && incoming().keys().hasAll(['id', 'orderNumber', 'customerName', 'phone', 'mode', 'items', 'total', 'paymentMethod', 'status', 'createdAt'])
        && incoming().id is string && incoming().id.size() <= 64
        && incoming().orderNumber is string && incoming().orderNumber.size() <= 32
        && incoming().customerName is string && incoming().customerName.size() >= 2 && incoming().customerName.size() <= 100
        && incoming().phone is string && incoming().phone.size() >= 6 && incoming().phone.size() <= 30
        && incoming().mode in ['pickup', 'delivery']
        && incoming().paymentMethod == 'cash'
        && incoming().status == 'received'
        && incoming().total is number && incoming().total > 0
        && incoming().items is list && incoming().items.size() > 0 && incoming().items.size() <= 50;

      // Status updates and rejection by Manager
      allow update: if isValidId(orderId) && (
        isAdmin() ||
        (
          // Allow manager state transitions with strictly restricted keys
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'rejectionReason', 'updatedAt'])
          && incoming().status in ['received', 'preparing', 'ready', 'delivering', 'completed', 'cancelled']
          && incoming().id == existing().id
          && incoming().total == existing().total
        )
      );

      // Only Manager can delete orders
      allow delete: if isValidId(orderId) && (isAdmin() || isSignedIn());
    }

    // Products Catalog
    match /products/{productId} {
      allow read: if isValidId(productId);
      allow create, update, delete: if isValidId(productId) && (isAdmin() || isSignedIn());
    }

    // Sunday Reservations Collection
    match /reservations/{reservationId} {
      allow read: if isValidId(reservationId);
      allow create: if isValidId(reservationId)
        && incoming().keys().hasAll(['id', 'customerName', 'phone', 'date', 'status', 'createdAt'])
        && incoming().status == 'pending'
        && incoming().customerName is string && incoming().customerName.size() >= 2
        && incoming().phone is string && incoming().phone.size() >= 6;
      allow update, delete: if isValidId(reservationId) && (isAdmin() || isSignedIn());
    }

    // Store Status Singleton
    match /storeStatus/{statusId} {
      allow read: if isValidId(statusId);
      allow create, update, delete: if isValidId(statusId) && (isAdmin() || isSignedIn());
    }

    // Admins Allowlist
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
    }
  }
}
