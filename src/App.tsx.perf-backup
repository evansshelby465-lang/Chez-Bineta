import React, { lazy, Suspense, useState, useEffect } from 'react';
import { CartProvider, useCart } from './context/CartContext';
import { AuthProvider } from './context/AuthContext';
import { Product, StoreStatus, Order } from './types';
import { INITIAL_PRODUCTS, INITIAL_STORE_STATUS } from './data/initialCatalog';
import { subscribeToProducts, seedInitialProductsIfNeeded } from './services/productService';
import { subscribeToStoreStatus } from './services/storeStatusService';

import { Navbar } from './components/Navbar';
import { BottomNav } from './components/BottomNav';
import { CartModal } from './components/CartModal';
import { SundayReservationModal } from './components/SundayReservationModal';
import { OfflineIndicator } from './components/OfflineIndicator';

const HomePage = lazy(() =>
  import('./pages/HomePage').then((module) => ({
    default: module.HomePage,
  }))
);

const MenuPage = lazy(() =>
  import('./pages/MenuPage').then((module) => ({
    default: module.MenuPage,
  }))
);

const TrackOrderPage = lazy(() =>
  import('./pages/TrackOrderPage').then((module) => ({
    default: module.TrackOrderPage,
  }))
);

const AdminTerminal = lazy(() =>
  import('./pages/AdminTerminal').then((module) => ({
    default: module.AdminTerminal,
  }))
);

const MorePage = lazy(() =>
  import('./pages/MorePage').then((module) => ({
    default: module.MorePage,
  }))
);

import { ShoppingBag, ArrowRight } from 'lucide-react';

function MainApp() {
  const [currentTab, setCurrentTab] = useState<string>('home');
  const [selectedCategory, setSelectedCategory] = useState<string | undefined>(undefined);
  const [isCartOpen, setIsCartOpen] = useState(false);
  const [isSundayModalOpen, setIsSundayModalOpen] = useState(false);
  const [trackedOrderId, setTrackedOrderId] = useState<string | null>(null);

  const [products, setProducts] = useState<Product[]>(INITIAL_PRODUCTS);
  const [storeStatus, setStoreStatus] = useState<StoreStatus>(INITIAL_STORE_STATUS);

  const { totalItemsCount, totalAmount } = useCart();

  // Initial seed and real-time subscription
  useEffect(() => {
    seedInitialProductsIfNeeded();
    const unsub = subscribeToProducts((prods) => {
      setProducts(prods);
    });
    return () => unsub();
  }, []);

  // Subscribe to real-time store status
  useEffect(() => {
    const unsub = subscribeToStoreStatus((status) => {
      setStoreStatus(status);
    });
    return () => unsub();
  }, []);

  const handleOrderSuccess = (order: Order) => {
    setIsCartOpen(false);
    setTrackedOrderId(order.id);
    setCurrentTab('orders');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  const handleNavigateToMenu = (category?: string) => {
    setSelectedCategory(category);
    setCurrentTab('menu');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  return (
    <div className="min-h-screen bg-[#faf8f5] text-stone-900 flex flex-col font-sans selection:bg-orange-500 selection:text-white relative overflow-x-hidden">
      <OfflineIndicator />

      {/* Global announcement banner */}
      {storeStatus.bannerNotice && (
        <div className="bg-gradient-to-r from-orange-600 via-orange-500 to-amber-500 text-white text-[11px] sm:text-xs font-black py-1.5 px-4 text-center tracking-wide shadow-xs">
          <span>📢 {storeStatus.bannerNotice}</span>
        </div>
      )}

      {/* Top Floating Glass Navigation Bar */}
      <Navbar
        currentTab={currentTab}
        setCurrentTab={setCurrentTab}
        storeStatus={storeStatus}
        onOpenCart={() => setIsCartOpen(true)}
      />

      {/* Main Container */}
      <main className="flex-1 max-w-5xl w-full mx-auto px-4 py-3 sm:py-5">
        <Suspense
          fallback={
            <div className="min-h-[50vh] flex items-center justify-center">
              <div className="text-sm font-bold text-stone-500">
                Chargement…
              </div>
            </div>
          }
        >
        {currentTab === 'home' && (
          <HomePage
            products={products}
            storeStatus={storeStatus}
            onNavigateToMenu={handleNavigateToMenu}
            onOpenSundayModal={() => setIsSundayModalOpen(true)}
            onTrackOrder={() => {
              setCurrentTab('orders');
              window.scrollTo({ top: 0, behavior: 'smooth' });
            }}
          />
        )}

        {currentTab === 'menu' && (
          <MenuPage
            products={products}
            initialCategory={selectedCategory}
          />
        )}

        {currentTab === 'orders' && (
          <TrackOrderPage initialOrderId={trackedOrderId} />
        )}

        {currentTab === 'admin' && (
          <AdminTerminal
            products={products}
            storeStatus={storeStatus}
          />
        )}

        {currentTab === 'more' && (
          <MorePage
            onNavigateToAdmin={() => setCurrentTab('admin')}
            onNavigateToSunday={() => setIsSundayModalOpen(true)}
          />
        )}
        </Suspense>
      </main>

      {/* Floating iOS Glass Cart Pill (Prompt Requirement 36) */}
      {totalItemsCount > 0 && !isCartOpen && (currentTab === 'home' || currentTab === 'menu') && (
        <div className="fixed bottom-22 left-4 right-4 z-40 max-w-md mx-auto animate-fadeIn">
          <button
            onClick={() => setIsCartOpen(true)}
            className="w-full py-3.5 px-5 rounded-[28px] btn-liquid-orange font-black text-sm sm:text-base flex items-center justify-between shadow-[0_12px_32px_rgba(255,107,0,0.4)] active:scale-98 transition-all"
          >
            <div className="flex items-center gap-3">
              <div className="relative">
                <ShoppingBag className="w-5 h-5 text-white" />
                <span className="absolute -top-1.5 -right-1.5 bg-stone-900 text-white text-[10px] w-4 h-4 rounded-full flex items-center justify-center font-black shadow-xs">
                  {totalItemsCount}
                </span>
              </div>
              <span>Voir le panier</span>
            </div>

            <div className="flex items-center gap-2">
              <span className="bg-white text-orange-600 text-xs sm:text-sm px-3 py-1 rounded-xl font-black shadow-xs">
                {totalAmount.toLocaleString('fr-FR')} FCFA
              </span>
              <ArrowRight className="w-4 h-4 text-white" />
            </div>
          </button>
        </div>
      )}

      {/* iOS Glass Cart Modal */}
      <CartModal
        isOpen={isCartOpen}
        onClose={() => setIsCartOpen(false)}
        onOrderSuccess={handleOrderSuccess}
      />

      {/* Sunday Pre-order Modal */}
      <SundayReservationModal
        isOpen={isSundayModalOpen}
        onClose={() => setIsSundayModalOpen(false)}
        products={products}
      />

      {/* Floating Bottom Navigation Bar */}
      <BottomNav
        currentTab={currentTab}
        setCurrentTab={(tab) => {
          setCurrentTab(tab);
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }}
        onOpenCart={() => setIsCartOpen(true)}
      />
    </div>
  );
}

export default function App() {
  return (
    <AuthProvider>
      <CartProvider>
        <MainApp />
      </CartProvider>
    </AuthProvider>
  );
}
